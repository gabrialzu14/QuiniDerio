<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/match_row" android:layout_width="match_parent" android:layout_height="54dp" android:gravity="center_vertical">
    <ImageView android:id="@+id/home_crest" android:layout_width="22dp" android:layout_height="28dp" android:scaleType="fitCenter" android:importantForAccessibility="no"/>
    <TextView android:id="@+id/home" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:maxLines="2" android:textSize="11sp" android:textColor="@color/widget_text"/>
    <LinearLayout android:layout_width="68dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
        <TextView android:id="@+id/state" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9sp" android:textColor="@color/widget_muted"/>
        <TextView android:id="@+id/score" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/widget_text"/>
        <TextView android:id="@+id/date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9sp" android:textColor="@color/widget_muted"/>
    </LinearLayout>
    <TextView android:id="@+id/away" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:maxLines="2" android:textSize="11sp" android:textColor="@color/widget_text"/>
    <ImageView android:id="@+id/away_crest" android:layout_width="22dp" android:layout_height="28dp" android:scaleType="fitCenter" android:importantForAccessibility="no"/>
</LinearLayout>
