<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_bg">
    <TextView android:id="@+id/header" android:layout_width="match_parent" android:layout_height="28dp" android:text="QuiniDerio" android:textStyle="bold" android:textSize="14sp" android:textColor="@color/widget_text"/>
    <LinearLayout android:id="@+id/matches" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical"/>
    <TextView android:id="@+id/updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Consultando jornada…" android:textSize="10sp" android:textColor="@color/widget_muted" android:maxLines="2"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical">
        <TextView android:id="@+id/previous" android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="‹" android:textSize="28sp" android:textColor="@color/widget_text" android:contentDescription="Anterior"/>
        <TextView android:id="@+id/page" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:gravity="center" android:textSize="11sp" android:textColor="@color/widget_muted"/>
        <TextView android:id="@+id/next" android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="›" android:textSize="28sp" android:textColor="@color/widget_text" android:contentDescription="Siguiente"/>
        <TextView android:id="@+id/refresh" android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="↻" android:textSize="24sp" android:textColor="@color/widget_text" android:contentDescription="Actualizar resultados"/>
    </LinearLayout>
</LinearLayout>
